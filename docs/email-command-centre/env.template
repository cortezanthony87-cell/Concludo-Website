# Email Command Centre: environment variable template
#
# Concludo Workspace, Email Command Centre module. Final, Stage 7.
#
# This file contains NO secrets and no real values. Every value below is a
# placeholder. Copy it to .env.local (which must be in .gitignore) and fill it
# in from the secret manager. Never commit a filled-in copy, and never paste a
# filled-in copy into a chat, a ticket or a document.
#
# Nothing in this module reads these variables today. The module runs on the
# synthetic dataset with no credentials at all. The list exists so the shape of
# the configuration is reviewable before any credential exists.
#
# The rule that decides which prefix a variable gets:
#   VITE_* is compiled into the browser bundle and is PUBLIC. Anyone who loads
#   the page can read it. A secret with a VITE_ prefix is a published secret.
#   Everything else is server side only.
#
# ---------------------------------------------------------------------------
# Browser (public, safe to ship)
# ---------------------------------------------------------------------------

# Where the browser sends connection and analysis requests.
VITE_CONCLUDO_API_BASE_URL=https://api.example.invalid

# Feature flag for the module. Off by default.
VITE_ECC_ENABLED=false

# Which provider connections the connect screen offers.
VITE_ECC_PROVIDERS=microsoft365,google

# ---------------------------------------------------------------------------
# Server: Microsoft 365 (Microsoft Graph)
# ---------------------------------------------------------------------------

MS_TENANT_MODE=single_tenant
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Secret or certificate thumbprint. Read from the secret manager at runtime.
# Do not write a value here.
MS_CLIENT_SECRET=
MS_CERTIFICATE_THUMBPRINT=

MS_REDIRECT_URI=https://api.example.invalid/oauth/microsoft/callback

# Base scopes, space separated. Must match src/lib/email/providers/scopes.ts.
# assertScopesPermitted() throws on anything not declared there.
MS_SCOPES_BASE=offline_access User.Read Mail.Read MailboxSettings.Read

# Requested incrementally, only on opt-in. Not requested at connection.
MS_SCOPES_INCREMENTAL_DRAFT=Mail.ReadWrite

# ---------------------------------------------------------------------------
# Server: Google Workspace (Gmail API)
# ---------------------------------------------------------------------------

GOOGLE_PROJECT_ID=example-project
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.invalid

# Read from the secret manager at runtime. Do not write a value here.
GOOGLE_CLIENT_SECRET=

GOOGLE_REDIRECT_URI=https://api.example.invalid/oauth/google/callback

GOOGLE_SCOPES_BASE=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/userinfo.email
GOOGLE_SCOPES_INCREMENTAL_DRAFT=https://www.googleapis.com/auth/gmail.compose

# Optional, only if push notifications are used later.
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=

# ---------------------------------------------------------------------------
# Server: token store
# ---------------------------------------------------------------------------

# Key reference, not a key. The store resolves this against the key management
# service. A raw key in an environment variable is a key in every process list,
# every crash dump and every container image layer.
TOKEN_STORE_KMS_KEY_REF=projects/example/locations/australia-southeast1/keyRings/example/cryptoKeys/token-store
TOKEN_STORE_KEY_ROTATION_DAYS=90

# ---------------------------------------------------------------------------
# Server: analysis store
# ---------------------------------------------------------------------------

SUPABASE_URL=https://example.supabase.invalid

# Service role key. Server side only, and never under a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Publishable key for the browser client.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server: model provider
# ---------------------------------------------------------------------------

MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=

# Recorded with every generated field. Bump whenever prompt text changes.
MODEL_PROMPT_VERSION=icc-2026-10
MODEL_SCHEMA_VERSION=ecc-analysis-v2

# ---------------------------------------------------------------------------
# Server: operational limits
# ---------------------------------------------------------------------------

# Default folder exclusions, applied before analysis.
ECC_EXCLUDED_FOLDERS=spam,junk,bin,trash,sent,archive

# Analysis retention in days. The sweep deletes analysis, never mail.
ECC_ANALYSIS_RETENTION_DAYS=365

# Attachment content processing. Opt-in per account; this is the hard ceiling.
ECC_ATTACHMENT_MAX_BYTES=5242880

# Sync safety valves.
ECC_SYNC_MAX_PAGES=50
ECC_SYNC_BACKOFF_ATTEMPTS=5

# Entitlement: Starter analyses three threads per week, resetting Monday
# 05:30 Australia/Melbourne. Pro and Team are unlimited.
ECC_STARTER_WEEKLY_THREAD_LIMIT=3
ECC_ENTITLEMENT_RESET_CRON=30 5 * * 1
ECC_ENTITLEMENT_RESET_TZ=Australia/Melbourne

# Timezone used to render dates when a mailbox does not report one.
ECC_FALLBACK_TIMEZONE=Australia/Melbourne

# ---------------------------------------------------------------------------
# Server: backlog mode and approvals (Stage 7)
# ---------------------------------------------------------------------------

# A paused backlog session older than this is not offered for resumption.
ECC_BACKLOG_SESSION_TTL_DAYS=7

# The hard ceiling on a custom batch size. The interface clamps to this.
ECC_BACKLOG_MAX_BATCH=200

# Rows a dashboard queue previews before linking to the paginated view. Raising
# this is how a dashboard ends up rendering a mailbox.
ECC_QUEUE_PREVIEW_SIZE=10

# Rows per page in All Email. Capped server side regardless of what a client
# asks for.
ECC_PAGE_SIZE_DEFAULT=25
ECC_PAGE_SIZE_MAX=100

# The one external action that can run at all, and only with an approval and
# the opt-in capability. The other four are disabled in code, not here: these
# flags cannot turn them on.
ECC_ALLOW_SAVE_DRAFT=false

# Present so that a reader looking for them finds them set to false with an
# explanation, rather than wondering whether they exist somewhere else.
# Setting any of these to true does nothing: the capability behind each is
# denied and ungrantable in providers/capabilities.ts, and planAction refuses
# the action by release state before it reads any flag.
ECC_ALLOW_SEND=false
ECC_ALLOW_ARCHIVE=false
ECC_ALLOW_DELETE=false
ECC_ALLOW_BULK_ACTIONS=false

# ---------------------------------------------------------------------------
# Server: scheduled jobs (Stage 7)
# ---------------------------------------------------------------------------

# Incremental synchronisation, per connected account.
ECC_SYNC_CRON=*/15 * * * *
ECC_SYNC_CRON_TZ=Australia/Melbourne

# Retention sweep. Deletes analysis, never mail.
ECC_RETENTION_CRON=0 3 * * *
ECC_RETENTION_CRON_TZ=Australia/Melbourne

# ---------------------------------------------------------------------------
# Server: observability (Stage 7)
# ---------------------------------------------------------------------------

# Where metrics and logs go. No value here is a secret; the credentials for
# these endpoints live in the secret manager.
ECC_METRICS_ENDPOINT=
ECC_LOG_LEVEL=info

# Application log retention in days. The audit trail in the database is kept
# longer and separately, because it is the record of what the system did.
ECC_LOG_RETENTION_DAYS=30
