# ==============================================================================
# Concludo Workspace — Environment Variables
# Copy this file to .env.local for local development.
# Configure these variables in your deployment host (e.g. Vercel, Netlify, Cloudflare).
# NEVER commit .env.local or secret keys to GitHub.
# ==============================================================================

# Supabase Project URL (Client & Server)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Safe for browser / client-side use)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Secret Key (STRICTLY SERVER-ONLY - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
